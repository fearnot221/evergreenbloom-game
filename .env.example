# JSON: each code must be unique, uppercase A-Z/0-9/hyphen and 16-80 characters.
STAMP_KEYS={"zhongda-road":"","tingsong":"","main-library":"","chungcheng-library":"","baihua":"","auditorium":"","zhongda-lake":"","friendship-sakura":"","csrsr-station":"","taichi":""}
# Google sign-in, the only way to sign in. Google Cloud Console → OAuth client (Web
# application), authorized redirect URI: <APP_ORIGIN>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
